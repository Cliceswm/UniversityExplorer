@*
    StudentApplicationRow: ONE row of the applications table.
    It has TWO buttons, each with its own EventCallback:
      - Edit   → OnEdit   ("Application selected for editing")
      - Delete → OnDelete ("Application selected for deleting")
    The row doesn't call the API itself. It just tells the parent page,
    and the PAGE decides what to do.
*@

<tr>
    <td>@Application.Id</td>
    <td>@Application.StudentName</td>
    <td>@Application.UniversityName</td>
    <td>@Application.Country</td>
    <td>@Application.CourseName</td>

    @* The API doesn't store dates for old records, so show "N/A" if empty *@
    <td>@(Application.ApplicationDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>

    <td>
        @* d-flex gap-2 = put the buttons side by side with a small space *@
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary"
                    @onclick="() => OnEdit.InvokeAsync(Application)">
                Edit
            </button>

            <button class="btn btn-sm btn-outline-danger"
                    @onclick="() => OnDelete.InvokeAsync(Application)">
                Delete
            </button>
        </div>
    </td>
</tr>

@code {
    // INPUT: the application shown in this row
    [Parameter, EditorRequired]
    public StudentApplication Application { get; set; } = default!;

    // OUTPUT: "the user wants to edit this application"
    [Parameter]
    public EventCallback<StudentApplication> OnEdit { get; set; }

    // OUTPUT: "the user wants to delete this application"
    [Parameter]
    public EventCallback<StudentApplication> OnDelete { get; set; }
}